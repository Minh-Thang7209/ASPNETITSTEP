@*
Приймаємо модель представлення (від контролера),
тут зазначаємо лише тип, самі дані доступні через Razor-властивість model
*@
@model ASPNETITSTEP.Models.Home.Models.HomeModelsViewModels
@{
    ViewData["Title"] = "Models";
}

<div class="text-center page-title">
    @*Звернення до даних, що приходить від контролера*@
    <h1 class="display-4">@Model.PageTitle</h1>
</div>
<p class="intro">
    @Model.Intro
</p>
<p class="classification-header">
    @Model.ClassificationHeader
</p>
<ul class="classification-list">
    @foreach (var item in Model.ClassificationList)
    {
        <li>@item</li>
    }
</ul>
<p class="example-header">
    @Model.ExampleHeader
</p>
<ul class="example-list">
    @foreach (var item in Model.ExampleList)
    {
        <li>@item</li>
    }
</ul>
<form asp-action="ModelsForm" method="post">
    <div>
        <label>Логін:</label>
        <input type="text" name="user-login">
    </div>
    <div>
        <label>Пароль:</label>
        <input type="password" name="user-passoword">
    </div>
    <div>
        <label>
            <input type="checkbox" name="user-agree" value="true">
            Я погоджуюсь з умовами
        </label>
    </div>
    <div>
        <p>Стать:</p>
        <label>
            <input type="radio" name="user-gender" value="male">
            Чоловіча
        </label>
        <label>
            <input type="radio" name="user-gender" value="female">
            Жіноча
        </label>
    </div>
    <div>
        <label>Дата народження:</label>
        <input type="date" name="user-birthdate">
    </div>

    <div>
        <label>Улюблений колір:</label>
        <input type="color" name="user-color">
    </div>

    <div>
        <label>Вік:</label>
        <input type="number" name="user-age">
    </div>

    <button type="submit">Відправити</button>
</form>
